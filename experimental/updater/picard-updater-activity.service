[Unit]
Description=Publish read-only Picard updater activity metadata
[Service]
Type=oneshot
User=root
ExecStart=/usr/local/lib/picard-updater/node --jitless /usr/local/lib/picard-updater/activity-report.mjs
TimeoutStartSec=10
MemoryMax=64M
StateDirectory=picard-updater-status
StateDirectoryMode=0755
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/picard-updater-status
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
[Install]
WantedBy=multi-user.target
