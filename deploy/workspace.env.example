# Optional fragment for an ALREADY enrolled Linux runtime. Disabled by default.
# Keep the existing owner, key, enrollment, catalogue and legacy baseline intact.
# Requires BRIDGE_CONSOLE_ENABLED, BRIDGE_ADMISSION_ENABLED,
# BRIDGE_ADMISSION_SIGNED_BRIDGE_ENABLED and
# BRIDGE_ADMISSION_REUSABLE_BOARD_ENABLED to already be true.
BRIDGE_WORKSPACE_ENABLED=false
