# Intentionally disabled. Never put secret values in this file or repository.
BRIDGE_ENABLED=false
BRIDGE_PROVIDER=groq
BRIDGE_ASSISTANT_ID=groq:openai/gpt-oss-20b
BRIDGE_OWNER_ID=REPLACE_WITH_YOUR_OWNER
BRIDGE_ALLOWED_TASK_ID=REPLACE_WITH_YOUR_APPROVED_TASK
BRIDGE_KEY_ID=REPLACE_WITH_YOUR_KEY_ID
BRIDGE_HMAC_SECRET_FILE=/etc/picard-relay/credentials/hmac
BRIDGE_DB_PATH=/var/lib/picard-relay/relay.db
BRIDGE_PORT=8787
BRIDGE_STOP_PATH=/var/lib/picard-relay/STOP
GROQ_ENABLED=false
GROQ_ONE_SHOT=true
GROQ_API_KEY_FILE=/etc/picard-relay/credentials/groq
GROQ_FREE_GATE_FILE=/etc/picard-relay/credentials/free-gate.json
GROQ_ONCE_MARKER_FILE=/var/lib/picard-relay/private/once.json
