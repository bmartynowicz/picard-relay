{
  "schemaVersion": 1,
  "updatedAt": "2026-11-13",
  "project": "Picard Relay",
  "summary": "Self-hosted bounded AI request workspace with durable saved answers, scoped local MCP access and a separate fixed-job compute broker.",
  "documentationIndex": "docs/README.md",
  "aiEntry": "llms.txt",
  "contributorInstructions": "AGENTS.md",
  "sourceOfTruth": {
    "behavior": "Source and tests at the selected commit",
    "deployment": "Physical installed manifest/source identity and authenticated host observations",
    "backlog": "Owner private task board; docs/work-register.json is a sanitized dated snapshot",
    "historicalDocs": "Checkpoint statements apply to their original date"
  },
  "entrypoints": [
    {
      "kind": "offline_demo",
      "command": "npm run demo",
      "requiresProvider": false,
      "opensListener": false
    },
    {
      "kind": "preview_runtime",
      "command": "npm start",
      "source": "src/oracle-service.mjs",
      "enabledByDefault": false
    },
    {
      "kind": "signed_runtime",
      "source": "experimental/runtime-control/src/oracle-service.mjs",
      "enabledByDefault": false,
      "requiresHostEnrollment": true
    },
    {
      "kind": "v1_synthetic_workspace",
      "command": "npm run preview:v1",
      "opensListener": true,
      "bind": "127.0.0.1:4391",
      "requiresProvider": false
    },
    {
      "kind": "offline_compute_broker",
      "command": "npm --prefix experimental/compute-broker run demo",
      "source": "experimental/compute-broker/mcp.mjs",
      "requiresProvider": false,
      "opensListener": false,
      "liveCloudExecutionEnabled": false
    },
    {
      "kind": "guided_fresh_host_setup",
      "command": "sudo bash scripts/setup-linux.sh",
      "guide": "docs/SETUP.md",
      "freshHostOnly": true,
      "providerCallsDuringSetup": 0,
      "requiresOwnerVerifiedFreeProject": true,
      "updaterEnrolled": true,
      "qualification": "Implementation source 5bd64b244e0eab0030387ec43fd22433b72f2149 passed native Oracle Linux 9.8 KVM with its own UEK kernel, 1 GB RAM and SELinux Enforcing in 43486575595; four-target setup in 43486575453; all seven Picard repository groups and saved receipt recovery in 43487084597 / 43487157562. Public ACME and real-key acceptance remain installation-specific, separate from synthetic CI.",
      "keyReplacementEnrolled": true,
      "signedRuntime": true
    }
  ],
  "runtime": {
    "nodeMajor": 24,
    "ciNodeVersion": "24.22.1",
    "sourceRoot": "experimental/runtime-control/src",
    "previewSourceRoot": "src",
    "moduleCount": 20,
    "allowlist": "experimental/updater/policy.example.json",
    "stateSchema": 1
  },
  "provider": {
    "id": "groq:openai/gpt-oss-20b",
    "model": "openai/gpt-oss-20b",
    "maxCallsPerGrant": 1,
    "maxOutputTokens": 4096,
    "tools": false,
    "executesGeneratedCode": false,
    "automaticInferenceRetries": 0,
    "paidFallback": false,
    "liveBillingVerification": false,
    "finiteCatalogueMaxOutputTokens": 512
  },
  "limits": {
    "catalogueEntries": 8,
    "catalogueSlotsTotal": 8,
    "catalogueMaxLifetimeMs": 86400000,
    "requestMaxLifetimeMs": 3600000,
    "requestTextMaxCharacters": 4000,
    "loadedHistoryRows": 100,
    "ownerSessions": 1,
    "ownerSessionLifetimeMs": 28800000,
    "statusStaleAfterMs": 60000,
    "updaterActivityStaleAfterMs": 180000,
    "toleratedFutureSkewMs": 5000,
    "visibleConsoleRefreshIntervalMs": 15000,
    "workspaceRequestLifetimeMs": 900000,
    "workspaceActiveJobs": 8,
    "workspaceLiveDrafts": 16,
    "workspaceReviewsPerResult": 100
  },
  "interfaces": {
    "browser": "docs/API.md",
    "signedBridgePath": "/bridge/v1",
    "controlSocket": "operator-configured BRIDGE_CONTROL_SOCKET; no public control route",
    "controlActions": [
      "health",
      "drain"
    ],
    "consoleHistoryScope": {
      "reusableBoardAdmissionEnabled": "configured owner across approved tasks",
      "otherwise": "configured owner and allowed task",
      "crossOwnerAccess": false
    },
    "workspaceMcp": {
      "transport": "local-stdio",
      "protocolVersion": "2025-06-18",
      "readOnlyTools": [
        "workspace_status",
        "workspace_list",
        "workspace_get"
      ],
      "optInAdditionalTools": [
        "workspace_prepare",
        "workspace_submit"
      ],
      "ownerApprovalTool": false,
      "credentialsIndependentOfBrowser": true,
      "contract": "docs/workspace-agent-contract.json"
    },
    "fixedProjectChecks": {
      "separateBroker": true,
      "requiresSeparateEnrollment": true,
      "arbitraryGeneratedCode": false,
      "guide": "experimental/compute-broker/CODING-WORKFLOW.md"
    }
  },
  "components": [
    {
      "path": "tools/workspace-mcp.mjs",
      "role": "local read-only owner-workspace MCP stdio adapter; existing authenticated HTTPS GETs, outside signed runtime"
    },
    {
      "path": "tools/workspace-readonly.mjs",
      "role": "fixed-origin GET-only workspace client with enrolled tool access or protected owner sessions, bounded data and saved-answer integrity checks"
    },
    {
      "path": "tools/workspace-agent-mcp.mjs",
      "role": "opt-in local stdio adapter adding inert drafts and exact owner-approved submission; no approval tool or automatic login"
    },
    {
      "path": "tools/workspace-access.mjs",
      "role": "owner-only enrollment, revocation and exact-draft approval; protected local tool cache, outside signed runtime"
    },
    {
      "path": "experimental/runtime-control/src/oracle-service.mjs",
      "role": "service, configuration, owner auth, typed status, base console"
    },
    {
      "path": "experimental/runtime-control/src/admission-ui.mjs",
      "role": "optional Requests view and inert saved-result display"
    },
    {
      "path": "experimental/runtime-control/src/relay-store.mjs",
      "role": "durable request and invocation ledger"
    },
    {
      "path": "experimental/runtime-control/src/dispatcher.mjs",
      "role": "lease/claim, invoke once and reconcile saved reply"
    },
    {
      "path": "experimental/runtime-control/src/receiver.mjs",
      "role": "signed request action validation"
    },
    {
      "path": "experimental/runtime-control/src/protocol.mjs",
      "role": "HMAC request/response protocol"
    },
    {
      "path": "experimental/runtime-control/src/admission-runtime.mjs",
      "role": "finite catalogue and production admission wiring"
    },
    {
      "path": "experimental/updater/updater.mjs",
      "role": "verified source update transaction"
    },
    {
      "path": "experimental/updater/activity-report.mjs",
      "role": "read-only updater metadata observer"
    },
    {
      "path": "experimental/compute-broker/src/broker.mjs",
      "role": "separate compute broker with disabled-by-default fixed Oracle and GitHub CI adapters, outside signed runtime"
    },
    {
      "path": "experimental/compute-broker/src/github-ci.mjs",
      "role": "read-only exact-commit observation of public Picard project CI; no credentials or dispatch"
    },
    {
      "path": "experimental/compute-broker/src/oracle-inventory.mjs",
      "role": "operator-configured pinned SSH inventory; no account API, execution enrollment or billing assertion"
    },
    {
      "path": "experimental/compute-broker/src/execution-profile.mjs",
      "role": "private finite exact-job enrollment"
    },
    {
      "path": "experimental/compute-broker/src/oracle-executor.mjs",
      "role": "fixed provider execution and saved-result collection"
    },
    {
      "path": "experimental/compute-broker/src/github-executor.mjs",
      "role": "fixed provider execution and saved-result collection"
    },
    {
      "path": "experimental/compute-broker/src/receipt.mjs",
      "role": "bounded authenticated-context result validation"
    },
    {
      "path": "experimental/compute-broker/unattended.mjs",
      "role": "owner-only finite unattended CI orchestration through actual MCP and ephemeral GitHub token"
    },
    {
      "path": "experimental/compute-broker/src/mcp-client.mjs",
      "role": "bounded private stdio client; saved-result recovery without credentials"
    },
    {
      "path": "experimental/compute-broker/coding-check.mjs",
      "role": "agent-facing exact-commit full-repository request preparation and read-only per-group result collection; legacy broker-only receipt recovery"
    },
    {
      "path": "experimental/compute-broker/src/repository-checks.mjs",
      "role": "pinned seven-group repository plan; offline npm, private home, Linux process-group deadlines and exact per-group result validation"
    }
  ],
  "release": {
    "workflow": ".github/workflows/sign-release.yml",
    "envelope": "releases/stable.json",
    "githubDeploysHosts": false,
